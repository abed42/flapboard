# Copy this file to .env.local and fill in the values from your Supabase
# project: Dashboard → Project Settings → API keys.
# https://supabase.com/dashboard/project/_/settings/api-keys

# Your project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# The "publishable" key (new format). Legacy "anon" keys work here too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
